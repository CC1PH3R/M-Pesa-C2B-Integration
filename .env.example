# Server Configuration
PORT=3000
NODE_ENV=production

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mpesa_c2b?schema=public"

# M-Pesa Daraja API Credentials
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=your_paybill_shortcode        # Used for both C2B and STK Push
MPESA_PASSKEY=your_passkey_here               # Lipa Na M-Pesa passkey (from Daraja dashboard)

# Sandbox test values:
#   MPESA_SHORTCODE=174379
#   MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# M-Pesa API URLs
MPESA_BASE_URL=https://sandbox.safaricom.co.ke   # sandbox
# MPESA_BASE_URL=https://api.safaricom.co.ke      # production

# Your Application URLs (Railway will provide this)
APP_BASE_URL=https://your-app.railway.app

# Response Type for validation (optional - Completed or Cancelled)
MPESA_RESPONSE_TYPE=Completed